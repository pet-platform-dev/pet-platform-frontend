NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional same-origin HTTP proxy. Keep NEXT_PUBLIC_API_URL absolute for messaging WebSockets.
NEXT_PUBLIC_API_PROXY_ENABLED=false
# Required when enabled; origins only, without trailing slash or /api/v1.
API_PROXY_BACKEND_ORIGIN=http://localhost:4000
API_PROXY_FRONTEND_ORIGIN=http://localhost:3000
